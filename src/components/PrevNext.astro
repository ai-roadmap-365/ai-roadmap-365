---
import type { DayContext } from '../lib/curriculum';

interface Props {
  prev?: DayContext;
  next?: DayContext;
}

const { prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="prev-next" aria-label="Lesson navigation">
  <span>
    {
      prev &&
        (prev.hasContent ? (
          <a href={`${base}/${prev.dayId}`}>← Day {prev.number}: {prev.title}</a>
        ) : (
          <span>← Day {prev.number}: {prev.title} (planned)</span>
        ))
    }
  </span>
  <span>
    {
      next &&
        (next.hasContent ? (
          <a href={`${base}/${next.dayId}`}>Day {next.number}: {next.title} →</a>
        ) : (
          <span>Day {next.number}: {next.title} (planned) →</span>
        ))
    }
  </span>
</nav>
